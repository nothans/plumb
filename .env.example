# Copy to .env next to compose.prod.yml and fill in. .env is not committed.
PLUMB_BASE_URL=https://judging.example.org
PLUMB_ADMIN_EMAIL=you@example.org
PLUMB_ADMIN_PASSWORD=change-me-to-12-or-more-characters
# The reverse proxy's address or network as uvicorn sees it (see README).
FORWARDED_ALLOW_IPS=127.0.0.1
