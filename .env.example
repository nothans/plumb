# Copy to .env next to compose.prod.yml and fill in. .env is not committed.
PLUMB_BASE_URL=https://judging.example.org
PLUMB_ADMIN_EMAIL=you@example.org
# 15 or more characters, a few words together work well. Left empty, no admin
# is created; set one later with: docker compose -f compose.prod.yml exec plumb python -m app.cli create-admin EMAIL NAME
PLUMB_ADMIN_PASSWORD=
# The reverse proxy's address, or its network (like 172.16.0.0/12 for a proxy
# container), as uvicorn sees it. Never "*": Plumb refuses to start with it.
FORWARDED_ALLOW_IPS=127.0.0.1
# PLUMB_PORT=8080
# PLUMB_SECURE_COOKIES=1
# PLUMB_RATE_LIMITS=signup=300/3600,login-ip=600/300
